generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Profession {
  DEV
  TESTER
  DESIGNER
  BA
  MARKETING
  DEVOPS
  PRODUCT_OWNER
}

enum UserStatusSignal {
  ONLINE
  BUSY
  IN_MEETING
  AWAY
  OFFLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PAUSED
  BLOCKED
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  COMPLETED
  REJECTED
  BUSY
}


enum WorkMode {
  OFFICE
  REMOTE
}

enum TaskRequestType {
  TRANSFER
  ASSIST
  REVIEW
  SUBTASK_APPROVAL
}

enum TaskRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  projects ProjectDepartment[]

  @@map("departments")
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  password     String?
  fullName     String           @map("full_name")
  avatar       String?
  coverImage   String?          @map("cover_image")
  googleId     String?          @unique @map("google_id")
  role         Role             @default(EMPLOYEE)
  profession   Profession       @default(DEV)
  jobTitle     String?          @map("job_title")
  phone        String?
  bio          String?
  statusSignal UserStatusSignal @default(ONLINE) @map("status_signal")
  customStatus String?          @map("custom_status")
  refreshToken String?          @map("refresh_token")
  departmentId String?          @map("department_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  department             Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedProjects          Project[]       @relation("ProjectOwner")
  managedProjects        Project[]       @relation("ProjectManager")
  memberships            ProjectMember[]
  assignedTasks          Task[]          @relation("TaskAssignee")
  createdTasks           Task[]          @relation("TaskCreator")
  comments               Comment[]
  auditLogs              AuditLog[]
  sentDirectMessages     DirectMessage[] @relation("SentMessages")
  receivedDirectMessages DirectMessage[] @relation("ReceivedMessages")
  sentCalls              CallLog[]       @relation("SentCalls")
  receivedCalls          CallLog[]       @relation("ReceivedCalls")
  sentTaskRequests       TaskRequest[]   @relation("SentTaskRequests")
  receivedTaskRequests   TaskRequest[]   @relation("ReceivedTaskRequests")
  assignedSubtasks       Subtask[]       @relation("SubtaskAssignee")

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  managerId   String?  @map("manager_id")
  createdById String   @map("created_by_id")
  stagesJson  String?  @map("stages_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User                @relation("ProjectOwner", fields: [createdById], references: [id], onDelete: Cascade)
  manager     User?               @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  departments ProjectDepartment[]
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]

  @@map("projects")
}

model ProjectDepartment {
  projectId    String @map("project_id")
  departmentId String @map("department_id")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
  @@map("project_departments")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(NORMAL)
  progress       Int          @default(0)
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  recurrenceRule String?      @map("recurrence_rule")
  isArchived     Boolean      @default(false) @map("is_archived")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at")
  completedAt    DateTime?    @map("completed_at")
  projectId      String       @map("project_id")
  assigneeId     String?      @map("assignee_id")
  createdById    String       @map("created_by_id")
  stageId        String?      @map("stage_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subtasks     Subtask[]
  tags         TaskTag[]
  comments     Comment[]
  taskRequests TaskRequest[]
  attachments  Attachment[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([createdById])
  @@index([status])
  @@index([isArchived])

  @@map("tasks")
}

model Subtask {
  id              String    @id @default(uuid())
  taskId          String    @map("task_id")
  title           String
  isDone          Boolean   @default(false) @map("is_done")
  isUrgent        Boolean   @default(false) @map("is_urgent")
  approvalStatus  String    @default("APPROVED") @map("approval_status")
  rejectionReason String?   @map("rejection_reason")
  order           Int       @default(0)
  assigneeId      String?   @map("assignee_id")
  dueDate         DateTime? @map("due_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User? @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("subtasks")
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String?
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])

  @@map("comments")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model DirectMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

model CallLog {
  id         String     @id @default(uuid())
  callerId   String     @map("caller_id")
  receiverId String     @map("receiver_id")
  type       CallType   @default(AUDIO)
  status     CallStatus @default(COMPLETED)
  duration   Int        @default(0)
  startedAt  DateTime   @default(now()) @map("started_at")
  endedAt    DateTime?  @map("ended_at")

  caller   User @relation("SentCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("call_logs")
}


model TaskRequest {
  id           String            @id @default(uuid())
  taskId       String            @map("task_id")
  senderId     String            @map("sender_id")
  receiverId   String            @map("receiver_id")
  type         TaskRequestType   @default(TRANSFER)
  status       TaskRequestStatus @default(PENDING)
  note         String?
  responseNote String?           @map("response_note")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender   User @relation("SentTaskRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedTaskRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([taskId, status])

  @@map("task_requests")
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   // 'file' or 'link'
  size      String?
  taskId    String   @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}
