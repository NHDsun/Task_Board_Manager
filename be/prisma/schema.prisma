// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  COMPLETED
  REJECTED
  BUSY
}

// 1. Department Model
model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users    User[]
  projects ProjectDepartment[]

  @@map("departments")
}

// 2. User Model
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String?
  fullName     String      @map("full_name")
  avatar       String?
  googleId     String?     @unique @map("google_id")
  role         Role        @default(EMPLOYEE)
  departmentId String?     @map("department_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  comments       Comment[]
  auditLogs      AuditLog[]
  sentDirectMessages     DirectMessage[] @relation("SentMessages")
  receivedDirectMessages DirectMessage[] @relation("ReceivedMessages")
  sentCalls              CallLog[]       @relation("SentCalls")
  receivedCalls          CallLog[]       @relation("ReceivedCalls")

  @@map("users")
}

// 3. Project Model
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User                @relation("ProjectOwner", fields: [createdById], references: [id], onDelete: Cascade)
  departments ProjectDepartment[]
  members     ProjectMember[]
  tasks       Task[]
  tags        Tag[]

  @@map("projects")
}

// 4. ProjectDepartment Junction Model (n-n Multi-Department)
model ProjectDepartment {
  projectId    String @map("project_id")
  departmentId String @map("department_id")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([projectId, departmentId])
  @@map("project_departments")
}

// 5. ProjectMember Junction Model
model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// 6. Task Model
model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(NORMAL)
  dueDate        DateTime?    @map("due_date")
  recurrenceRule String?      @map("recurrence_rule")
  isArchived     Boolean      @default(false) @map("is_archived")
  projectId      String       @map("project_id")
  assigneeId     String?      @map("assignee_id")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subtasks  Subtask[]
  tags      TaskTag[]
  comments  Comment[]

  @@map("tasks")
}

// 7. Subtask Model
model Subtask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false) @map("is_completed")
  taskId      String   @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

// 8. Tag Model
model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6B7280")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@map("tags")
}

// 9. TaskTag Junction Model
model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// 10. Comment Model
model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// 11. AuditLog Model
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// 12. DirectMessage Model (Chat riêng 1-1 giữa nhân viên)
model DirectMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

// 13. CallLog Model (Lịch sử cuộc gọi thoại AUDIO và VIDEO)
model CallLog {
  id         String     @id @default(uuid())
  callerId   String     @map("caller_id")
  receiverId String     @map("receiver_id")
  type       CallType   @default(AUDIO)
  status     CallStatus @default(COMPLETED)
  duration   Int        @default(0)
  startedAt  DateTime   @default(now()) @map("started_at")
  endedAt    DateTime?  @map("ended_at")

  caller   User @relation("SentCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("call_logs")
}
